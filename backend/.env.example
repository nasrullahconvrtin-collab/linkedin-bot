SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_secret_key
PORT=8000

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://linkedflow-dashboard.vercel.app,http://localhost:5173

# Sending window — times in SEND_WINDOW_TZ timezone (default UTC)
SEND_WINDOW_START=08:00
SEND_WINDOW_END=20:00
SEND_WINDOW_TZ=Asia/Karachi

# Daily connection limit per profile (can also be set per-profile in DB)
DAILY_CONNECTION_LIMIT=25
