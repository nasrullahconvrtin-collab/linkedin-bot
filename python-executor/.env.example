# Same backend every team member points at
BACKEND_URL=https://linkedin-bot-backend-production.up.railway.app

# Unique per team member - just pick any short identifier, e.g. "jane" or
# "ali_account1". No pairing step needed: the first heartbeat creates this
# profile in Supabase automatically if it doesn't exist yet.
PROFILE_KEY=

# How often to poll for jobs and heartbeat, in seconds.
POLL_INTERVAL_SECONDS=60
