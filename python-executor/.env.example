# Same backend every team member points at
BACKEND_URL=https://linkedin-bot-backend-production.up.railway.app

# Unique per team member - just pick any short identifier, e.g. "jane" or
# "ali_account1". No pairing step needed: the first heartbeat creates this
# profile in Supabase automatically if it doesn't exist yet.
PROFILE_KEY=

# How often to poll for jobs and heartbeat, in seconds.
POLL_INTERVAL_SECONDS=60

# Optional: AI vision fallback for when LinkedIn changes a button's wording
# and the fast hardcoded matching can't find it anymore. Get a key at
# console.anthropic.com - costs roughly $1-5/month for a handful of profiles
# since it's only called on failures, not on every click. Leave blank to
# disable this entirely (the script still works, it just won't self-recover
# from LinkedIn UI changes - you'd need a code fix instead).
ANTHROPIC_API_KEY=
